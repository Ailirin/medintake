# Каталог состояния сервиса: очередь, принятые пакеты, отчёты.
MEDINTAKE_DATA_DIR=var

# Корень, из которого API принимает каталог (путь в запросе только относительный).
MEDINTAKE_INBOX_ROOT=var/inbox

# Справочник МКБ-10: off | warn | error
# warn — кода нет в файле, это предупреждение (пока справочник неполный).
# error — такого кода достаточно, чтобы отклонить документ.
MEDINTAKE_ICD10_MODE=warn

MEDINTAKE_MAX_FILES=10000
MEDINTAKE_MAX_FILE_BYTES=2097152
MEDINTAKE_MAX_DOCUMENT_AGE_DAYS=366

# Часовой пояс, в котором считается «сегодня» для проверок дат (сервер и контейнер живут в UTC).
MEDINTAKE_TIMEZONE=Europe/Moscow

# false — принятые XML (ФИО, СНИЛС, полис) удаляются после построения отчёта.
# true — только для разбора инцидентов на стенде.
MEDINTAKE_KEEP_INPUT=false

MEDINTAKE_HOST=127.0.0.1
MEDINTAKE_PORT=8080
MEDINTAKE_LOG_LEVEL=INFO

# Пустое значение отключает проверку. На стенде токен обязателен.
MEDINTAKE_API_TOKEN=
