<?xml version="1.0" encoding="UTF-8"?>
<!--
  Внутренний документ для предварительной проверки перед выгрузкой в контур страховой.
  Это не формат реестра счетов ТФОМС.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="GenderType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="M"/>
      <xs:enumeration value="F"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InsuranceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OMS"/>
      <xs:enumeration value="DMS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InsurerCodeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PolicyNumberType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9-]{6,30}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Icd10Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z][0-9]{2}(\.[0-9]{1,2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SnilsType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{3}-[0-9]{3}-[0-9]{3} [0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DateType">
    <xs:restriction base="xs:date"/>
  </xs:simpleType>

  <xs:complexType name="PatientType">
    <xs:sequence>
      <xs:element name="LastName" type="xs:string"/>
      <xs:element name="FirstName" type="xs:string"/>
      <xs:element name="MiddleName" type="xs:string" minOccurs="0"/>
      <xs:element name="BirthDate" type="DateType"/>
      <xs:element name="Gender" type="GenderType"/>
      <xs:element name="Snils" type="SnilsType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DiagnosisType">
    <xs:sequence>
      <xs:element name="Icd10Code" type="Icd10Type"/>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="IsPrimary" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MedicalDocumentType">
    <xs:sequence>
      <xs:element name="DocumentId" type="xs:string"/>
      <xs:element name="DocumentDate" type="DateType"/>
      <xs:element name="InsuranceType" type="InsuranceType"/>
      <xs:element name="InsurerCode" type="InsurerCodeType"/>
      <xs:element name="PolicyNumber" type="PolicyNumberType"/>
      <xs:element name="OrganizationCode" type="xs:string"/>
      <xs:element name="Patient" type="PatientType"/>
      <xs:element name="Diagnosis" type="DiagnosisType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="version" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="1.1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="MedicalDocument" type="MedicalDocumentType"/>
</xs:schema>
